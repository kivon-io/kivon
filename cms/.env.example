# Postgres: use the DigitalOcean *connection pool* URI (port 25061), not the direct one
DATABASE_URL=postgresql://kivoncms:PASSWORD@HOST:25061/kivoncms-pool?sslmode=require
# Optional: DO cluster CA certificate contents, for full TLS verification
DATABASE_CA_CERT=

PAYLOAD_SECRET=generate-with-openssl-rand-hex-32
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# DigitalOcean Spaces
S3_ENDPOINT=https://lon1.digitaloceanspaces.com
S3_REGION=lon1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public (CDN) base URL for files, e.g. https://BUCKET.lon1.cdn.digitaloceanspaces.com
S3_PUBLIC_URL=
